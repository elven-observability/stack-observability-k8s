+/*
+ * Copyright The OpenTelemetry Authors
+ * Elven Observability contributors: synchronous Jedis4 terminal-error backport tests.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package io.opentelemetry.javaagent.instrumentation.jedis.common.v1_4;
+
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.verifyNoInteractions;
+import static org.mockito.Mockito.verifyNoMoreInteractions;
+
+import io.opentelemetry.context.Context;
+import io.opentelemetry.instrumentation.api.instrumenter.Instrumenter;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+class JedisRequestContextTest {
+  @SuppressWarnings("unchecked")
+  private final Instrumenter<Object, Void> instrumenter = mock(Instrumenter.class);
+  private final Context context = Context.root();
+  private final Object request = new Object();
+
+  @AfterEach
+  void noThreadLocalLeak() {
+    JedisRequestContext<Object> fresh = JedisRequestContext.attach();
+    assertNotNull(fresh, "Every completion must detach the old thread-local context");
+    fresh.detachAndEnd();
+  }
+
+  @Test
+  void emptyContextDoesNotInventSpan() {
+    JedisRequestContext<Object> owner = JedisRequestContext.attach();
+    assertNotNull(owner);
+    owner.detachAndEnd(new IllegalStateException("before any Redis command"));
+    verifyNoInteractions(instrumenter);
+  }
+
+  @Test
+  void terminalReadFailureWinsOverEarlierSendFailure() {
+    JedisRequestContext<Object> owner = JedisRequestContext.attach();
+    assertNotNull(owner);
+    Throwable sendFailure = new IllegalStateException("send");
+    Throwable terminalFailure = new IllegalStateException("WRONGTYPE");
+    JedisRequestContext.endIfNotAttached(instrumenter, context, request, sendFailure);
+    verifyNoInteractions(instrumenter);
+    owner.detachAndEnd(terminalFailure);
+    verify(instrumenter).end(context, request, null, terminalFailure);
+    verifyNoMoreInteractions(instrumenter);
+  }
+
+  @Test
+  void sendFailureIsNotLostWhenTerminalFailureIsAbsent() {
+    JedisRequestContext<Object> owner = JedisRequestContext.attach();
+    assertNotNull(owner);
+    Throwable sendFailure = new IllegalStateException("transport");
+    JedisRequestContext.endIfNotAttached(instrumenter, context, request, sendFailure);
+    owner.detachAndEnd(null);
+    verify(instrumenter).end(context, request, null, sendFailure);
+    verifyNoMoreInteractions(instrumenter);
+  }
+
+  @Test
+  void legacyNoArgumentCallerKeepsSendFailure() {
+    JedisRequestContext<Object> owner = JedisRequestContext.attach();
+    assertNotNull(owner);
+    Throwable sendFailure = new IllegalStateException("legacy transport");
+    JedisRequestContext.endIfNotAttached(instrumenter, context, request, sendFailure);
+    owner.detachAndEnd();
+    verify(instrumenter).end(context, request, null, sendFailure);
+    verifyNoMoreInteractions(instrumenter);
+  }
+
+  @Test
+  void nestedAttachDoesNotOwnOrEndAnotherSpan() {
+    JedisRequestContext<Object> owner = JedisRequestContext.attach();
+    assertNotNull(owner);
+    assertNull(JedisRequestContext.attach());
+    JedisRequestContext.endIfNotAttached(instrumenter, context, request, null);
+    verifyNoInteractions(instrumenter);
+    owner.detachAndEnd(null);
+    verify(instrumenter).end(context, request, null, null);
+    verifyNoMoreInteractions(instrumenter);
+  }
+
+  @Test
+  void successfulRequestEndsOnceWithoutInventingError() {
+    JedisRequestContext<Object> owner = JedisRequestContext.attach();
+    assertNotNull(owner);
+    JedisRequestContext.endIfNotAttached(instrumenter, context, request, null);
+    owner.detachAndEnd(null);
+    verify(instrumenter).end(context, request, null, null);
+    verifyNoMoreInteractions(instrumenter);
+  }
+}
