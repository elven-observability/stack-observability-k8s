# No NuGet network sources or application SDK: this tests eBPF HTTP only.
FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:fe0fd4e93bd2fbb47c883b7a6369e5c8d3db8bf01cdc5981f6ee35fbdf3ff4fb AS build
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
WORKDIR /src
COPY dotnet.csproj Program.cs NuGet.Config ./
RUN dotnet publish dotnet.csproj --configfile NuGet.Config --output /out -p:UseSharedCompilation=false --nologo
FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:bfd912c83295ce66d4b706ebb8541b9f14259b0e76fbb88b2751f58ce2399d2e
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_EnableDiagnostics=0
COPY --from=build /out /app
WORKDIR /app
USER 10001:10001
ENTRYPOINT ["dotnet", "/app/dotnet.dll"]
