# Synthetic application only: injected agent is the sole SDK/exporter.
FROM docker.io/library/eclipse-temurin:17-jdk-jammy@sha256:81336a07f69ac361c7f278183b195e32037ebdb532684996806265a3b47ef516
WORKDIR /fixture
COPY PrivacyFixture.java *.jar /fixture/
RUN javac --release 17 --add-modules jdk.httpserver -cp '/fixture/*' PrivacyFixture.java
RUN java --add-modules jdk.httpserver -cp '/fixture:/fixture/*' PrivacyFixture --check-dependencies
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "--add-modules", "jdk.httpserver", "-cp", "/fixture:/fixture/*", "PrivacyFixture"]
