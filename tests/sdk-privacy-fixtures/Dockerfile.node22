# Synthetic clients and telemetry API only; never bundle a provider/exporter.
FROM docker.io/library/node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
WORKDIR /fixture
COPY package.json package-lock.json /fixture/
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY --chown=10001:10001 main.js /fixture/main.js
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["node", "/fixture/main.js"]
